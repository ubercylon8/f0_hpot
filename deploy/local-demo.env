# Local demo environment — source these when starting the stack manually.
# API:
#   F0_DB_PATH=/tmp/opencode/f0demo.db
#   F0_API_PORT=18443
#   F0_ENROLLMENT_TOKEN=bootstrap-test-123
#   F0_AGENT_RELEASE_DIR=<repo>/agent/bin
#   F0_GATEWAY_ORIGIN=http://localhost:18080
#   F0_INTERNAL_SECRET=local-demo-secret
# Gateway:
#   F0_API_BASE_URL=http://127.0.0.1:18443
#   F0_HTTP_PORT=18080 F0_DNS_PORT=15353
#   F0_TOKEN_DOMAINS=localhost,tokens.example.com
#   F0_GATEWAY_ORIGIN=http://localhost:18080
#   F0_INTERNAL_SECRET=local-demo-secret   # MUST match the API: once any
#     console API key exists, incident forwards without the secret are 401
#
# With these set, generated token artifacts embed URLs that resolve and
# trigger locally (http://localhost:18080/<id>/...). The gateway probes
# the API at startup and warns loudly if its credentials are rejected.
