# f0_deception deployment configuration.
# Copy to .env and fill in before running docker compose.

# Comma-separated base domains for tokens. Wildcard DNS
# (*.tokens.yourdomain.com) must point at this host's public IP,
# plus NS/A records so the gateway can answer DNS queries.
F0_TOKEN_DOMAINS=tokens.yourdomain.com

# Public origin used when generating token artifacts (URLs shown to users).
# Defaults to https://<first token domain>.
F0_GATEWAY_ORIGIN=https://tokens.yourdomain.com

# Public IP answered by the gateway's DNS server (A records).
F0_GATEWAY_IP=203.0.113.10

# Domain(s) accepted for unique-email tokens (MX -> this host).
# Defaults to F0_TOKEN_DOMAINS when empty.
F0_MAIL_DOMAINS=alerts.yourdomain.com

# SMTP ingest port published for email tokens. Use 25 if publishing directly;
# otherwise front it with your MTA of choice.
F0_SMTP_PORT=2525

# Domain the web console is served on (Caddy will obtain TLS certs).
CONSOLE_DOMAIN=console.yourdomain.com

# REQUIRED: console/API auth. The admin token is the bootstrap master key
# (used by the console login page and to create persistent API keys via
# POST /api/v1/auth/keys). Generate: openssl rand -base64 32
F0_ADMIN_TOKEN=change-me-admin-token

# REQUIRED: shared secret authorizing the gateway to forward incidents and
# fetch internal token config from the API. Generate: openssl rand -base64 32
F0_INTERNAL_SECRET=change-me-internal-secret

# Bootstrap token for agent enrollment (agents cannot enroll without it).
F0_ENROLLMENT_TOKEN=change-me-enrollment-token

# Alert throttle: max alerts per unique (token, source IP) per minute.
F0_MAX_ALERTS_PER_MINUTE=1

# OPTIONAL: GeoIP enrichment of incident source IPs (country/city/lat-lon
# stored on each incident + world map on the dashboard). Point at any
# MaxMind-format .mmdb — DB-IP city-lite is a free no-account download:
#   curl -O https://download.db-ip.com/free/dbip-city-lite-YYYY-MM.mmdb.gz
#F0_GEOIP_DB=/data/dbip-city-lite.mmdb
